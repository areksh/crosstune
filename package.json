{
  "name": "qobuz-helper",
  "version": "0.0.0",
  "description": "A collection of local-first utilities for Qobuz.",
  "type": "module",
  "bin": {
    "qobuz-helper": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "ui": "npm run build && node dist/cli.js ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
